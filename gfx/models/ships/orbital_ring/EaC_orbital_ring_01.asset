@cull_radius = 100









entity = {
	name = "avian_01_orbital_ring_tier_0_entity"
	pdxmesh = "orbital_ring_tier_01_frame_mesh"

	default_state = "idle"
	state = { name = "idle" state_time = 5 animation = "idle" }

	cull_radius = @cull_radius
}



